# Brevo transactional email — used by the contact form (POST /api/contact).
# Copy to .env.local and fill in real values (never commit secrets).

# API key from your Brevo account (SMTP & API > API Keys). Required.
BREVO_API_KEY=

# Verified sender email/domain in Brevo (the "from" address). Required.
BREVO_SENDER_EMAIL=

# Recipient for contact-form notifications. Optional — defaults to the public
# contact email (eva@biezunski-avocat.fr) defined in src/lib/constants.ts.
BREVO_TO_EMAIL=


# Notion Publications — powers /publications (App Router, ISR). When NOTION_TOKEN
# is absent, the site serves mock publications so local dev / CI build without secrets.

# Notion internal integration token (Settings > Integrations). Required in prod.
NOTION_TOKEN=

# Notion database id backing the Publications list. Required in prod.
NOTION_DATABASE_ID=

# Optional: the data source id inside that database. If omitted, it is resolved
# at runtime from NOTION_DATABASE_ID (databases.retrieve -> data_sources[0].id).
NOTION_DATA_SOURCE_ID=

# Vercel Blob read/write token — mirrors Notion images to permanent URLs (Notion
# signed URLs expire ~1h). Auto-injected on Vercel when a Blob store is linked;
# required in production or cover/inline images will break after ~1h.
BLOB_READ_WRITE_TOKEN=

# Shared secret authorizing POST /api/revalidate?secret=… (Notion/Vercel webhook).
REVALIDATE_SECRET=
