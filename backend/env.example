# Backend (Django) environment. Local docker values live in docker-compose.yml.
DJANGO_DEBUG=0
SECRET_KEY=change-me
DATABASE_URL=postgres://user:password@host:5432/db
ALLOWED_HOSTS=www.example.com
CSRF_TRUSTED_ORIGINS=https://www.example.com
SITE_URL=https://www.example.com
# Set these three for Production only: on Preview, VERCEL_URL / VERCEL_BRANCH_URL are
# trusted automatically and SITE_URL falls back to the branch URL.

# Secret back-office path (same value as the frontend), used in password-reset links.
BACKOFFICE_PATH=admin-change-me

# Media storage: "filesystem" (local) or "vercel_blob" (production).
STORAGE_BACKEND=vercel_blob
BLOB_READ_WRITE_TOKEN=

# Next.js on-demand revalidation (same secret as the frontend).
# Leave empty on Vercel: it falls back to SITE_URL (a service binding would be circular).
FRONTEND_INTERNAL_URL=
REVALIDATE_SECRET=

# Password-reset emails through the Brevo SMTP relay (console backend when unset).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
BREVO_SENDER_EMAIL=
